
# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_assistant

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# RAG formatting fallback chain (textbook → structured monograph conversion)
RAG_FORMATTING_MODELS=tencent/hy3:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemini-3.1-flash-lite,anthropic/claude-haiku-latest,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Reranker — Jina AI free API (1M tokens/month, no credit card)
# Get your free key at: https://jina.ai → Sign up → Copy API key
# If not set, results are sorted by vector score (still good quality)
JINA_API_KEY=your-jina-api-key

# File Storage
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# AWS S3 (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
